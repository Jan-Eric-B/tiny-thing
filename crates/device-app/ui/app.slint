// The Device's screen: 800x480, white text on a dark ground.

export component AppWindow inherits Window {
    in property <string> now-playing-title;
    in property <string> now-playing-artist;

    title: "TinyThing Simulator";
    width: 800px;
    height: 480px;
    background: #000000;

    VerticalLayout {
        padding: 48px;
        spacing: 12px;
        alignment: center;

        Text {
            text: root.now-playing-title;
            color: #ffffff;
            font-size: 44px;
            font-weight: 700;
            overflow: elide;
        }

        Text {
            text: root.now-playing-artist;
            color: #ffffff;
            font-size: 30px;
            overflow: elide;
        }
    }
}
