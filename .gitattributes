# LF everywhere: Yocto recipes and shell scripts run on Linux and break on CRLF.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.qoi binary
*.ttf binary
*.otf binary
*.woff2 binary
*.zip binary
*.swu binary
